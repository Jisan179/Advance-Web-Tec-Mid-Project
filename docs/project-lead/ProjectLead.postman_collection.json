              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"lead@example.com\",\n  \"password\": \"password123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            }
          }
        },
        {
