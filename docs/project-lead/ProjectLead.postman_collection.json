          }
        },
        {
          "name": "Remove Member",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/projects/{{projectId}}/members/{{membershipId}}",
              "host": ["{{baseUrl}}"],
              "path": ["projects", "{{projectId}}", "members", "{{membershipId}}"]
            }
          }
        }
      ]
